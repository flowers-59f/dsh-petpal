{
  "name": "dsh-petpal",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "PetPal: show petdex.dev pets as a desktop companion in DeepSeek Harness on macOS and Windows.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "package.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "desktop/main.swift",
    "desktop/web/index.html",
    "desktop/build.sh",
    "desktop/PetdexPet.app",
    "desktop/windows/*.cs",
    "desktop/windows/*.csproj",
    "desktop/windows/app.manifest",
    "desktop/windows/build.sh",
    "desktop/windows/PetPal.exe",
    "desktop/windows/PetPal.exe.config",
    "desktop/windows/tools/dwebp.exe",
    "desktop/windows/LICENSE.webp",
    "desktop/windows/THIRD-PARTY-NOTICES.md",
    "screenshots.json",
    "docs/bubble.png"
  ],
  "scripts": {
    "test": "node test/render.test.mjs && node test/boot.test.mjs && node test/notification.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "author": "flowers-59f",
  "license": "MIT",
  "homepage": "https://github.com/flowers-59f/dsh-petpal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowers-59f/dsh-petpal.git"
  },
  "bugs": {
    "url": "https://github.com/flowers-59f/dsh-petpal/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "desktop-pet",
    "petdex",
    "macos",
    "windows"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  }
}
